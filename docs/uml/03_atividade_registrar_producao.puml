@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
title Atividade — registro guiado de produção

start
:Verificar sessão e perfil Registro de Produção;
if (Acesso permitido?) then (sim)
else (não)
  :Solicitar login ou informar falta de permissão;
  stop
endif
:Preencher data atual e unidade do usuário;
:Permitir ajuste da data (dia da produção, nunca futura)
e seleção da etapa;

if (Etapa = Maromba?) then (sim)
  :Ocultar fornada, linhas e classificação;
  :Mostrar quantidade por formato ativo;
else (não)
  :Listar fornadas em andamento da unidade
  (até duas: uma saindo, outra entrando);
  if (Etapa = Enforna?) then (sim)
    :Selecionar a fornada que está recebendo Enforna
    ou escolher "Nova fornada";
    note right
      "Nova fornada" gera o número sequencial
      do mês (RN06) e só aparece quando nenhuma
      fornada está recebendo Enforna, isto é,
      quando a anterior já foi marcada como
      "Enforna concluída" (RN08).
    end note
    :Por formato: linhas enfornadas e
    tijolos por linha (preenchido com a referência);
    :Calcular total = linhas x tijolos por linha,
    com total e tijolos por linha editáveis (RN12);
  else (Desenforna)
    if (Existe fornada em andamento?) then (sim)
      :Selecionar a fornada que está saindo;
    else (não)
      :Informar que não há fornada para desenfornar;
      stop
    endif
    :Por formato: linhas desenfornadas,
    1ª qualidade, 2ª qualidade e Cru que saiu;
    note right
      O Cru que fica no forno
      não é registrado (RN10).
    end note
  endif
endif

repeat
  :Preencher ou revisar os campos aplicáveis;
  :Verificar obrigatoriedade, inteiros >= 0
  e alguma quantidade de tijolos > 0;
  if (Campos válidos?) then (sim)
    if (Algum valor fora do esperado?) then (sim)
      :Exibir aviso "Está certo?" com o motivo;
      note right
        RN14 — aviso, nunca bloqueio:
        linhas acima da capacidade do forno;
        quantidade acima de linhas x referência;
        Desenforna acima do enfornado na fornada;
        produção muito diferente da média recente.
        Confirmação com um toque; o Gestor de
        Produção vê o aviso na validação.
      end note
      if (Continuar com os valores?) then (sim)
        :Exibir resumo completo;
      else (corrigir)
        :Marcar revisão necessária;
      endif
    else (não)
      :Exibir resumo completo;
    endif
  else (não)
    :Indicar campos a corrigir;
    :Marcar revisão necessária;
  endif
repeat while (Revisão necessária ou usuário escolheu Editar?) is (sim) not (não)

if (Confirmar o resumo?) then (sim)
  :Enviar lançamento ao servidor;
else (cancelar)
  :Descartar formulário sem criar lançamento;
  stop
endif

:Revalidar sessão, perfil, unidade, campos,
fornada e unicidade no servidor;
if (Existe registro não cancelado com a mesma chave?) then (sim)
  :Recusar duplicidade e oferecer Meus Registros;
  stop
endif
if (Demais regras atendidas?) then (sim)
  :Gravar lançamento Pendente, detalhes e auditoria
  em uma única transação (e a nova fornada, se escolhida);
else (não)
  :Informar erro e manter dados para correção;
  stop
endif
if (Gravação confirmada pelo servidor?) then (sim)
  :Exibir sucesso e resumo do registro salvo;
else (não)
  :Exibir falha ou ausência de confirmação;
  :Preservar formulário e orientar consulta
  a Meus Registros antes de reenviar;
endif
stop
@enduml
